# Debian 13 (trixie): ffmpeg 7.1. Debian 12's ffmpeg 5.1 returns empty sections when seeking
# in Twitch HLS VODs (ADR-0031).
FROM python:3.12-slim-trixie

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg ca-certificates fonts-montserrat fonts-dejavu-core fontconfig \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev

RUN useradd -m clipforge \
 && mkdir -p /data/blobs /home/clipforge/.cache/huggingface \
 && chown -R clipforge /data /home/clipforge/.cache
USER clipforge
