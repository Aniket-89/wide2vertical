# Copy to .env and edit. Never commit .env.
CLIPFORGE_ENV=dev
CLIPFORGE_LOG_LEVEL=INFO
CLIPFORGE_LOG_JSON=true
CLIPFORGE_API_TOKEN=change-me-to-a-long-random-string

# Local (non-docker) runs; docker-compose overrides these.
CLIPFORGE_DATABASE_URL=postgresql+psycopg://clipforge:clipforge@127.0.0.1:5432/clipforge
CLIPFORGE_REDIS_URL=redis://127.0.0.1:6380/0
CLIPFORGE_BLOB_ROOT=./data/blobs
CLIPFORGE_RAW_VIDEO_RETENTION_DAYS=7

# Feature flags
CLIPFORGE_ENABLE_LIVE=false
CLIPFORGE_ENABLE_AUTOPUBLISH=false
CLIPFORGE_ENABLE_LLM_JUDGE=false
CLIPFORGE_ENABLE_KICK_CHAT=false
CLIPFORGE_ENABLE_TWITCH_CHAT_GQL=false
CLIPFORGE_ENABLE_YOUTUBE_CHAT_REPLAY=false

# Transcription
CLIPFORGE_WHISPER_MODEL=small
CLIPFORGE_WHISPER_DEVICE=cpu
CLIPFORGE_WHISPER_COMPUTE_TYPE=int8

# LLM judge (M3) - a PAID service. Off unless ENABLE_LLM_JUDGE=true AND a key is set.
# Provider: anthropic | openrouter | groq | openai_compat (any OpenAI-compatible endpoint)
CLIPFORGE_LLM_PROVIDER=anthropic
CLIPFORGE_ANTHROPIC_API_KEY=
# Key for openrouter / groq / openai_compat:
CLIPFORGE_LLM_API_KEY=
# Required for openai_compat (e.g. http://127.0.0.1:8001/v1 for a local vLLM/Ollama)
CLIPFORGE_LLM_BASE_URL=
# Model id in the provider's own naming; must be set for non-anthropic providers
CLIPFORGE_LLM_MODEL=claude-haiku-5-5
CLIPFORGE_LLM_TIMEOUT_S=90
CLIPFORGE_LLM_MAX_RETRIES=3
CLIPFORGE_JUDGE_BATCH_SIZE=8
CLIPFORGE_JUDGE_MAX_WINDOWS_PER_VIDEO=150
# USD per 1M tokens for the cost estimate in usage_events: set these for YOUR model
CLIPFORGE_LLM_PRICE_IN_PER_MTOK=0.10
CLIPFORGE_LLM_PRICE_OUT_PER_MTOK=0.50
